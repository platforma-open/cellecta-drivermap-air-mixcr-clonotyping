// The steps a run of the preset takes, each once, in run order, with the :resources row it is
// sized by. :plan-steps renders this over the step list `analyze --dry-run-json` wrote.

self := import("@platforma-sdk/workflow-tengo:tpl")
smart := import("@platforma-sdk/workflow-tengo:smart")
mixcrSteps := import(":mixcr-steps")
presetTraits := import(":preset-traits")
resources := import(":resources")

self.defineOutputs("stepDefaults")

// The settings show the one field a step override sets.
_ruleOf := func(row) {
	return { memFloor: row.memFloor }
}

self.body(func(inputs) {
	presetContent := inputs.presetContent.getDataAsJson()

	// The run rejects these presets, so there is no step list to show.
	unsupported := presetTraits.unsupportedReason(presetContent)
	if !is_undefined(unsupported) {
		return { stepDefaults: smart.createJsonResource({ "error": unsupported }) }
	}

	plan := mixcrSteps.commands(mixcrSteps.stepsOf(inputs.steps.getDataAsJson()), inputs.readsPattern)

	seen := {}
	steps := []
	for c in plan.commands {
		row := resources.lookup(c.key)
		// Rows that take no override are not listed: the settings could not change them.
		if seen[c.key] || row.override == false {
			continue
		}
		seen[c.key] = true
		steps = append(steps, { step: c.key, defaultRule: _ruleOf(row) })
	}

	return { stepDefaults: smart.createJsonResource({ steps: steps }) }
})
