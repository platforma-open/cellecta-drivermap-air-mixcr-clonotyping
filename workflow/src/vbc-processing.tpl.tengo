// filter & normalize VBCs

self := import("@platforma-sdk/workflow-tengo:tpl.light")
assets := import("@platforma-sdk/workflow-tengo:assets")
exec := import("@platforma-sdk/workflow-tengo:exec")
pcolumn := import("@platforma-sdk/workflow-tengo:pframes.pcolumn")

self.defineOutputs(["tsv", "logs"])

vbcFilterSw := assets.importSoftware("@platforma-open/cellecta.drivermap-mixcr-clonotyping.vbc-filtering:main")
vbcNormalizationSw := assets.importSoftware("@platforma-open/cellecta.drivermap-mixcr-clonotyping.vbc-normalization:main")

f := exec.formula

// pandas holds the per-(clone, VBC) table in memory several times over; unmeasured, sized at
// 10x the TSV with a 4 GiB floor.
_resources := func() {
	return { onCPU: {
		cpu: 1,
		ram: f.size("tsv").times(10).atLeast(f.gib(4)).staticFallback(f.gib(16))
	} }
}

self.body(func(inputs) {
	inputFile := inputs.__value__

	filterCmd := exec.builder().
		name("vbc filter").
		inMediumQueue().
		resources(_resources()).
		printErrStreamToStdout().
		saveStdoutStream().
		software(vbcFilterSw).
		arg("input.tsv").
		arg("output").
		addFile("input.tsv", inputFile, { tag: "tsv" }).
		saveFile("output.tsv").
		saveFile("output.kde.maximas.txt").
		run()

	normalizeCmd := exec.builder().
		name("vbc normalize").
		inMediumQueue().
		resources(_resources()).
		printErrStreamToStdout().
		saveStdoutStream().
		software(vbcNormalizationSw).
		arg("input.kde.maximas.txt").
		arg("input.tsv").
		arg("output.tsv").
		addFile("input.kde.maximas.txt", filterCmd.getFile("output.kde.maximas.txt")).
		addFile("input.tsv", filterCmd.getFile("output.tsv"), { tag: "tsv" }).
		saveFile("output.tsv").
		run()

	// The two commands' streams, keyed by run position and step (`1:filter`), the same shape as
	// the MiXCR step logs. filter.py prints its threshold and normalization-reliability warnings
	// here; nothing else surfaces them.
	logs := pcolumn.resourceMapBuilder( /* keyLength */ 1 )
	logs.add(["1:filter"], filterCmd.getStdoutStream())
	logs.add(["2:normalize"], normalizeCmd.getStdoutStream())

	return {
		tsv: normalizeCmd.getFile("output.tsv"),
		logs: logs.build()
	}
})
