test := import("@platforma-sdk/workflow-tengo:test")
exec := import("@platforma-sdk/workflow-tengo:exec")
rs := import(":resources")

f := exec.formula

_gib := func(n) { return n * 1073741824 }

// Evaluates a formula node against a fake staged input of sizeBytes.
_evalSize := func(node, sizeBytes) {
	fileName := "input.bin"
	inputs := {}
	inputs[rs.INPUT_TAG] = [fileName]
	resolved := f.resolveAst(node, inputs, [fileName])
	resolver := { size: func(files) { return sizeBytes }, lineCount: func(files) { return 0 } }
	return f.evaluateResource(resolved, resolver, "test")
}

// A row's memory for a fake staged input of sizeBytes: a string for a flat row, bytes otherwise.
_ram := func(step, sizeBytes) {
	node := rs.ram(rs.lookup(step))
	return is_string(node) ? node : _evalSize(node, sizeBytes)
}

TestLookupFallsBackToTheDefault := func() {
	test.isEqual("assemble", rs.lookup("assemble").step)
	test.isEqual(rs.DEFAULT.memFloor, rs.lookup("findAlleles").memFloor)
	test.isEqual("findAlleles", rs.lookup("findAlleles").step)
}

TestFlatRowsAreFixedRequests := func() {
	test.isEqual("32GiB", _ram("align", _gib(100)))
	test.isEqual("4GiB", _ram("plan", _gib(100)))
}

TestQcIsSizedFromTheClns := func() {
	// max(32, 8 + 16 x GiB).
	test.isEqual(_gib(32), _ram("qc", _gib(1)))
	test.isEqual(_gib(168), _ram("qc", _gib(10)))
}

TestAssembleIsSizedFromTheVdjca := func() {
	// max(32, 10 x GiB), rounded up.
	test.isEqual(_gib(32), _ram("assemble", _gib(3)))
	test.isEqual(_gib(186), _ram("assemble", _gib(186) / 10))
	test.isEqual(_gib(300), _ram("assemble", _gib(30)))
}

TestRefineHasA32GiBFloor := func() {
	test.isEqual(_gib(32), _ram("refineTagsAndSort", _gib(39) / 100))
	test.isEqual(_gib(140), _ram("refineTagsAndSort", _gib(954) / 100))
}

TestTheDefaultScalesWithItsInput := func() {
	test.isEqual(_gib(64), _ram("findAlleles", _gib(10)))
	test.isEqual(_gib(80), _ram("findAlleles", _gib(20)))
}

TestStaticFallbackIsTheFloorOr64 := func() {
	test.isEqual(_gib(64), f.fallbackOf(rs.ram(rs.lookup("refineTagsAndSort"))))
	// A floor above 64 is the fallback.
	test.isEqual(_gib(100), f.fallbackOf(rs.ram({ step: "x", memFloor: 100, memIntercept: 0, memSlope: 1 })))
}

TestCpuIsTheInterceptWhileTheSlopeIs0 := func() {
	test.isEqual(16, rs.cpu(rs.lookup("align")))
	test.isEqual(16, rs.cpu(rs.lookup("assemble")))
	test.isEqual(16, rs.cpu(rs.lookup("refineTagsAndSort")))
	test.isEqual(16, rs.cpu(rs.DEFAULT))
	test.isEqual(4, rs.cpu(rs.lookup("qc")))
}

// A command stand-in that records what apply sets on it.
_fakeCmd := func() {
	cmd := {}
	cmd.resources = func(r) { cmd.queue = r.queue; cmd.onCPU = r.onCPU; return cmd }
	return cmd
}

TestTheMemoryOverrideRaisesTheFloor := func() {
	res := { perProcessMemGB: 100 }
	test.isEqual("100GiB", rs.apply(_fakeCmd(), rs.lookup("align"), res).onCPU.ram)
	// An override below the row's floor has no effect.
	test.isEqual("32GiB", rs.apply(_fakeCmd(), rs.lookup("align"), { perProcessMemGB: 8 }).onCPU.ram)
	// The data term still applies above the raised floor: 10 x 20 = 200.
	test.isEqual(_gib(100), _evalSize(rs.ram(rs.effective(rs.lookup("assemble"), res).row), _gib(1)))
	test.isEqual(_gib(200), _evalSize(rs.ram(rs.effective(rs.lookup("assemble"), res).row), _gib(20)))
	// A fractional override rounds up to a whole GiB.
	test.isEqual("33GiB", rs.apply(_fakeCmd(), rs.lookup("align"), { perProcessMemGB: 32.5 }).onCPU.ram)
	// A row with override: false keeps its own grant.
	test.isEqual("4GiB", rs.apply(_fakeCmd(), rs.lookup("plan"), res).onCPU.ram)
}

TestTheCpuOverrideReplacesTheRow := func() {
	test.isEqual(8, rs.apply(_fakeCmd(), rs.lookup("align"), { perProcessCPUs: 8 }).onCPU.cpu)
}

TestScratchIsOffOnlyWhereARowOptsOut := func() {
	res := { scratchFreeSpace: "44GiB" }
	test.isEqual("44GiB", rs.apply(_fakeCmd(), rs.lookup("assemble"), res).onCPU.scratchFreeSpace)
	test.isEqual("44GiB", rs.apply(_fakeCmd(), rs.DEFAULT, res).onCPU.scratchFreeSpace)
	cmd := rs.apply(_fakeCmd(), rs.lookup("plan"), res)
	test.isTrue(is_undefined(cmd.onCPU.scratchFreeSpace))
	test.isEqual("light", cmd.queue)
	cmd = rs.apply(_fakeCmd(), rs.lookup("qc"), res)
	test.isTrue(is_undefined(cmd.onCPU.scratchFreeSpace))
	test.isEqual("medium", cmd.queue)
	test.isEqual("heavy", rs.apply(_fakeCmd(), rs.DEFAULT, res).queue)
}

TestAStepOverrideReplacesOnlyTheFloor := func() {
	res := { stepResources: { assemble: { memFloor: 100 } } }
	e := rs.effective(rs.lookup("assemble"), res)
	test.isEqual(100, e.row.memFloor)
	test.isEqual(10, e.row.memSlope)
	test.isEqual("step", e.source.memFloor)
	// Another step is untouched.
	test.isEqual(32, rs.effective(rs.lookup("align"), res).row.memFloor)
}

TestAStepOverrideBeatsTheGlobalOverrides := func() {
	res := { perProcessMemGB: 200, stepResources: { assemble: { memFloor: 50 } } }
	e := rs.effective(rs.lookup("assemble"), res)
	test.isEqual(50, e.row.memFloor)
	test.isEqual(10, e.row.memSlope)
	// Steps without their own value still take the global overrides.
	a := rs.effective(rs.lookup("align"), res)
	test.isEqual(200, a.row.memFloor)
	test.isEqual("global", a.source.memFloor)
}

TestAStepOverrideReachesAStepOnTheDefaultRow := func() {
	res := { stepResources: { findAlleles: { memFloor: 99 } } }
	test.isEqual(99, rs.effective(rs.lookup("findAlleles"), res).row.memFloor)
}

TestStepOverrideValuesBecomeWholeGiB := func() {
	res := { stepResources: { assemble: { memFloor: 16.2 } } }
	test.isEqual(17, rs.effective(rs.lookup("assemble"), res).row.memFloor)
}

TestRowsWithoutOverridesIgnoreStepOverrides := func() {
	res := { stepResources: { plan: { memFloor: 64 } } }
	test.isEqual(4, rs.effective(rs.lookup("plan"), res).row.memFloor)
}

TestQcTakesStepAndGlobalOverrides := func() {
	test.isEqual(64, rs.effective(rs.lookup("qc"), { stepResources: { qc: { memFloor: 64 } } }).row.memFloor)
	test.isEqual(40, rs.effective(rs.lookup("qc"), { perProcessMemGB: 40 }).row.memFloor)
}

TestAStepFloorWinsOverTheGlobalMemoryOverride := func() {
	e := rs.effective(rs.lookup("assemble"), { perProcessMemGB: 40 })
	test.isEqual(40, e.row.memFloor)
	test.isEqual("global", e.source.memFloor)
	e = rs.effective(rs.lookup("assemble"), { perProcessMemGB: 40, stepResources: { assemble: { memFloor: 16 } } })
	test.isEqual(16, e.row.memFloor)
	test.isEqual("step", e.source.memFloor)
}
